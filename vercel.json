{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/router?route=$1"
    },
    {
      "source": "/((?!assets|robots\\.txt|sitemap\\.xml|api).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/router.ts": {
      "maxDuration": 30
    }
  }
}
